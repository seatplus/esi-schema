{
    "name": "seatplus/esi-schema",
    "description": "Generated ESI response DTOs, versioned independently by ESI compatibility date. Zero runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "monolog/monolog": "^3.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-type-coverage": "^3.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.0",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Seatplus\\EsiSchema\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "test:unit": "vendor/bin/pest --no-coverage",
        "test:lint": "vendor/bin/pint --test",
        "lint": "vendor/bin/pint",
        "test:types": "vendor/bin/phpstan analyse --no-progress",
        "test:type-coverage": "vendor/bin/pest --type-coverage --min=100"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "ignore",
            "block-insecure": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
