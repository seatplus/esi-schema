{
    "name": "seatplus/esi-schema",
    "description": "Fully typed PHP SDK for EVE Online's ESI API, generated from the official OpenAPI spec. One class per endpoint with typed response DTOs, OAuth scopes, cache lifetimes and rate-limit metadata. Zero runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "eve-online",
        "eveonline",
        "esi",
        "eve",
        "ccp",
        "api-client",
        "sdk",
        "openapi",
        "dto",
        "typed",
        "seatplus"
    ],
    "homepage": "https://github.com/seatplus/esi-schema",
    "support": {
        "issues": "https://github.com/seatplus/esi-schema/issues",
        "source": "https://github.com/seatplus/esi-schema"
    },
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "monolog/monolog": "^3.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/phpstan": "^2.0",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Seatplus\\EsiSchema\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "test:unit": "vendor/bin/pest --tia --no-coverage",
        "test:lint": "vendor/bin/pint --test",
        "lint": "vendor/bin/pint",
        "test:types": "vendor/bin/phpstan analyse --no-progress",
        "test:type-coverage": "vendor/bin/pest --type-coverage --min=100"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "ignore",
            "block-insecure": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
