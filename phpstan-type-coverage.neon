# The 100% type-coverage gate, kept in its own config so it stays scoped to the
# public surface (`src`) no matter which paths phpstan.neon.dist grows to cover.
#
# This is the same engine and the same three thresholds that
# pestphp/pest-plugin-type-coverage configured. That plugin is not used, because
# its 5.x line forks workers that each read-modify-write one cache file inside
# `vendor/`, with a lock that gives up after 100ms and writes anyway. The
# spliced result is invalid PHP, and the plugin `include`s it on the next run —
# so a single corrupted run breaks every later run until the file is deleted by
# hand. Running the rules directly through PHPStan avoids the fork entirely and
# is roughly 3x faster.
#
# `level: 0` is deliberate: the real analysis lives in phpstan.neon.dist at
# level 4. Here we only want the type-coverage collectors and rules.

includes:
    - vendor/tomasvotruba/type-coverage/config/extension.neon

parameters:
    level: 0
    paths:
        - src
    tmpDir: build/phpstan-type-coverage
    type_coverage:
        return_type: 100
        param_type: 100
        property_type: 100
